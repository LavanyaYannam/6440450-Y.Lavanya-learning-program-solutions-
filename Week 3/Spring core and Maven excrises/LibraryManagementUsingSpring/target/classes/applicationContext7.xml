<?xml version="1.0" encoding="UTF-8"?>
<beans xmlns="http://www.springframework.org/schema/beans"
       xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
       xsi:schemaLocation="
           http://www.springframework.org/schema/beans 
           http://www.springframework.org/schema/beans/spring-beans.xsd">

    <!-- Define BookRepository -->
    <bean id="bookRepository" class="Exercise7.BookRepository" />

    <!-- BookService with constructor + setter injection -->
    <bean id="bookService" class="Exercise7.BookService">
        <!-- Constructor injection -->
        <constructor-arg value="Library Admin" />
        <!-- Setter injection -->
        <property name="bookRepository" ref="bookRepository" />
    </bean>

</beans>
